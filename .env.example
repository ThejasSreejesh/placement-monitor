# === Telegram API credentials ===
# Get these from https://my.telegram.org  ->  API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# Your phone number in international format, e.g. +919876543210
PHONE=+91XXXXXXXXXX

# === Group to monitor ===
# Use the public @username, OR the numeric chat id (e.g. -1001234567890),
# OR the exact group title. You can list your groups with:  python placement_monitor.py --list
GROUP=@your_placement_group

# === Scheduler ===
# How often to scan, in minutes (used with --schedule)
SCAN_INTERVAL_MINUTES=60

# Output Excel file
OUTPUT_XLSX=placement_offers.xlsx
